.env
# Local-only Google Cloud work-mode helper (isolated CLOUDSDK_CONFIG); see pdl-gcloud.sh
/pdl-gcloud.sh
venv
.venv/
azure
notes.txt
azure_app.py
__Pycache__*
__pycache__/
dist
build
archives
notebooks
seychelles_package
media/vectordb/
openstax_resources */
media
design/LOCAL_TESTING_GUIDE.md



# Pulumi stack secrets passphrase — never commit
infra/.pulumi-passphrase

# macOS metadata
.DS_Store

# Local dev database (production uses Postgres). Each developer gets
# their own SQLite via `manage.py migrate` — no value in version control.
db.sqlite3
# SQLite WAL/SHM (transient — written when the dev server holds db.sqlite3)
*.sqlite3-shm
*.sqlite3-wal

# Local research / external datasets (kept out of git)
research/
# Annotator-agent run transcripts — large JSONL audit trails, regenerable
ops/annotator_agent/transcripts/
# Annotator-agent runtime metric log — regenerable from transcripts
ops/annotator_agent/metrics_history.jsonl

# Claude Code local state. .claude/skills/* IS tracked (project-level
# skill definitions); everything else under .claude/ is local user state.
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/

# Scratch debug screenshots — root-level only. Real images live under
# media/ or static/. Curated UI screenshots that document a feature go
# under screenshots/ (also ignored — re-take from current code if needed).
/*.png
/screenshots/
/test-files/

# A/B test outputs — transcripts, judge scores, and final reports.
# Regenerable from scripts/run_ab_test.py + scripts/judge_transcripts.py.
# Covers the baseline `ab-test-reports/` and per-variant sibling dirs
# (`ab-test-reports-v4/`, `-v5/`, `-v6/`, `-v6-top-tier/`, etc.) written
# by the wrappers in scripts/run_ab_v{N}_cycle.py.
ab-test-reports/
ab-test-reports-*/

# Production content dump used for local A/B testing — contains real
# lesson content + may include institution-scoped data. Loaded into the
# Dockerized Postgres at test time; not tracked.
prod_content_dump.sql

# Eval sweep runtime artifacts (per-model run logs + the flock lockfile)
offline_eval/**/.sweep.lock
offline_eval/**/*.log
.claude/loop.md

# Generated review output (regenerate with build_viewer.py / export_review_data.py)
offline_eval/experiment_review/

# Generated deployable viewer (regenerate with build_viewer.py; deploy config is tracked)
offline_eval/viewer_deploy/index.html

# Terminal tutor client --debug session logs
logs/

# collectstatic output (regenerated on service start)
staticfiles/

# ONNX encoder build artifacts (scripts/export_minilm_onnx.py) — ~90 MB
models/

# Vendored native binaries for the desktop installer (manage.py stage_ollama).
# ~31 MB per platform, reproducible from a released Ollama.
vendor/

# Self-hosted deployment backups. These contain student records — database
# dumps and uploaded media. backup.sh writes here by default.
deploy/compose/backups/

# Local-verification compose override (native arch instead of amd64).
deploy/compose/docker-compose.localtest.yml

# Built wheels (python -m build --outdir dist_wheel)
dist_wheel/

# Source curriculum PDFs for the Mozambique pilot. Third-party textbooks, ~37 MB
# of binaries, and this repository is going public — publishing someone else's
# course materials is not ours to do, and git history keeps them forever.
mozambique/

# Security paperwork. The posture-and-roadmap document names gaps that are not
# closed yet, and the folder also holds a document belonging to a different
# client. The ZAP scan configs below are committed deliberately — they carry no
# credentials, only ${ZAP_*} placeholders.
security/*.docx
security/zap/reports/

# Security paperwork that landed under tests/ rather than security/. Same rule
# as the security/*.docx entry above: several of these are assessments of
# migration.edwardamoah.com — a different site, not ours to publish — and the
# consolidated registers name findings that are still open.
tests/security/
tests/*Security_Assessment*.docx

# Raw sweep logs beside the eval results. The JSON is the result and is
# committed; the log is the console spew that produced it, up to 27 MB for a
# single arm, and no .log under multi_turn_results has ever been tracked.
offline_eval/multi_turn_results/**/*.log

# Node — only the CSS build needs it; package-lock.json IS committed
node_modules/

# Screenshot gate for the Tailwind migration — large, machine-specific
.screens/
