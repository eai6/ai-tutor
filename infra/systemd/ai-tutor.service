[Unit]
# The tutor web app, served to students over the Jetson's own WiFi hotspot.
# Boots headless: power on the board, students join the AP and open a browser.
Description=AI Tutor web app (gunicorn)
After=network-online.target ollama.service
Wants=network-online.target
Requires=ollama.service

[Service]
Type=notify
User=eai6
Group=eai6
WorkingDirectory=/home/eai6/Documents/ai-tutor

# config.settings_kiosk, not config.settings: the latter forces Secure cookies
# whenever DEBUG is False, and a browser never returns those over the hotspot's
# plain HTTP — login 403s and no session is ever established. See that module.
Environment=DJANGO_SETTINGS_MODULE=config.settings_kiosk
Environment=PYTHONUNBUFFERED=1

# Without this the app resolves tutoring to the ACTIVE DB row —
# anthropic/claude-haiku — and calls the cloud. On a hotspot with no internet
# that means the tutor cannot answer at all. This is the single most important
# line in the file.
# NO TUTOR_MODEL_OVERRIDE here on purpose. That env var short-circuits
# ModelConfig.get_for('tutoring'), so pinning it would make the admin's model
# picker in /admin/ silently ineffective — the UI would save a change that never
# took effect. The active purpose='tutoring' ModelConfig row is authoritative
# instead, and admins change it from the browser.
#
# The safety net that used to justify pinning it is now the row itself: it must
# point at a local model, or the box calls the cloud and cannot answer offline.
#
# This file can still force a model for testing, and wins when present:
#   sudo scripts/tutor_kiosk.sh model local_ollama/qwen3.5:2b
#   sudo scripts/tutor_kiosk.sh model default      (removes it, DB back in charge)
EnvironmentFile=-/etc/default/ai-tutor

# Must match ollama.service. See the comment there.
Environment=OLLAMA_FLASH_ATTENTION=1
Environment=OLLAMA_KV_CACHE_TYPE=q8_0
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_MAX_LOADED_MODELS=1

# sentence-transformers contacts huggingface.co on load even when the model is
# cached. Offline that is 20 s of DNS retries and then a RuntimeError, which
# takes out the grader's embedding tier.
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1

# DEBUG off: this listens on a network students are on, and tracebacks leak
# source. Static files still work because WhiteNoise is in MIDDLEWARE and
# ExecStartPre collects them. ALLOWED_HOSTS is '*' deliberately — the AP hands
# out 10.42.0.x but the same box is also reachable on whatever LAN address DHCP
# gave it, and Django cannot express a subnet here.
Environment=DEBUG=False
Environment=ALLOWED_HOSTS=*
Environment=CSRF_TRUSTED_ORIGINS=http://10.42.0.1,http://10.42.0.1:80

# Collect on every start so template or vendored-asset changes are picked up
# without anyone remembering to run it. Migrations too — a schema drift on a
# headless box is otherwise invisible until a student hits a 500.
ExecStartPre=/home/eai6/Documents/ai-tutor/.venv/bin/python manage.py migrate --noinput
ExecStartPre=/home/eai6/Documents/ai-tutor/.venv/bin/python manage.py collectstatic --noinput

# Port 80 so students type http://10.42.0.1 with no port number. Binding a
# privileged port as a non-root user needs the capability below.
#
# 2 workers, not the Dockerfile's 4: each is a full Django process and this box
# is already giving ~4 GB to the model. Concurrency past that is pointless
# anyway — Ollama serves one request at a time at NUM_PARALLEL=1, so extra
# workers queue on the model rather than adding throughput.
#
# timeout 300 is load-bearing. gunicorn's default is 30 s and a tutoring turn
# takes 20-90 s (longer on a cold model), so the default silently kills every
# reply mid-generation.
ExecStart=/home/eai6/Documents/ai-tutor/.venv/bin/gunicorn config.wsgi:application \
    --bind 0.0.0.0:80 \
    --workers 2 \
    --threads 4 \
    --timeout 300 \
    --graceful-timeout 30 \
    --access-logfile - \
    --error-logfile -

AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
