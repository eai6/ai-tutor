# Lean Django image for the annotator-agent compose stack.
#
# NOT the production Dockerfile — production lives at ./Dockerfile and
# pre-downloads whisper/piper/sentence-transformers (~10 min build).
# This image skips the ML model pre-downloads because the agent loop
# never exercises STT/TTS/figure-vision. Marked clearly so no one ships
# this to Azure by mistake.
#
# Used by ops/annotator_agent/docker-compose.yml.
FROM python:3.12-slim AS builder

WORKDIR /build
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
# Install everything except the heavy embedding/inference stack — the
# annotator runs against existing data, no ChromaDB queries, no audio.
# Keep torch CPU-only because chromadb still imports it transitively.
RUN pip install --no-cache-dir \
    torch --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir -r requirements.txt

# ---------------------------------------------------------------------
FROM python:3.12-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE=config.settings \
    DEBUG=true \
    DATABASE_URL=sqlite:///./db.sqlite3

COPY --from=builder /usr/local /usr/local
COPY . .

EXPOSE 8000
# No collectstatic, no migrations beyond what's already in the volume-
# mounted db.sqlite3. The compose file mounts ./db.sqlite3 from the
# host so we keep the same data the local dev server uses.
CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]
