# AI Tutor — configuration for a self-hosted deployment.
#
#   cp env.example .env && chmod 600 .env
#
# Then fill in everything marked REQUIRED. Nothing here has a safe default that
# works unattended — the app refuses to start rather than serve traffic with a
# publicly-known signing key.
#
# Read by docker-compose.yml in this directory. Keep .env out of version control.


# ─────────────────────────────────────────────────────────────────────────
# REQUIRED — the deployment will not start without these
# ─────────────────────────────────────────────────────────────────────────

# Signing key for sessions, password-reset links and CSRF tokens. Generate one:
#
#     python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#
# Anyone who learns this value can forge a login as any user, including staff.
# Generate a fresh one per deployment; never reuse it between environments and
# never commit it.
SECRET_KEY=

# The hostname students will type. Comma-separated if more than one.
# Django rejects requests carrying any other Host header, which is what stops a
# request smuggled through another domain from being trusted.
ALLOWED_HOSTS=tutor.education.gov.xx

# Must include the scheme, unlike ALLOWED_HOSTS. Without it every form POST
# fails CSRF validation — including the login form, with no useful error.
CSRF_TRUSTED_ORIGINS=https://tutor.education.gov.xx

# Database password for the bundled Postgres container.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# At least ONE LLM provider key. The tutor cannot answer without one.
# Which model serves which purpose is configured in the admin at
# /admin/llm/modelconfig/ after first start, not here.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# The domain Caddy requests a TLS certificate for, and the address Let's
# Encrypt will contact about expiry. The domain must already resolve to this
# server's public IP, or certificate issuance fails.
SITE_DOMAIN=tutor.education.gov.xx
ACME_EMAIL=ict@education.gov.xx


# ─────────────────────────────────────────────────────────────────────────
# Serving mode — read the comment before changing either of these
# ─────────────────────────────────────────────────────────────────────────

# Leave False. True exposes full tracebacks — including configuration and
# fragments of student data — to anyone who can reach an error page, and
# disables the ALLOWED_HOSTS check entirely.
DEBUG=False

# Whether something in front of Django terminates TLS. Caddy does, so `true`
# is correct for the shipped setup.
#
# Set this to `false` ONLY if you are serving plain HTTP on an isolated
# network. The symptom of getting it wrong is specific and confusing: login
# returns 403 with no error anywhere, because Django marks the session and CSRF
# cookies Secure and a browser will not send those over http://.
HTTPS_EDGE=true


# ─────────────────────────────────────────────────────────────────────────
# Optional
# ─────────────────────────────────────────────────────────────────────────

# Interface language before a user signs in. Per-course locale takes over
# afterwards. Examples: en-us, pt-mz, fr.
DEFAULT_LANGUAGE=en-us

# Outbound email — password resets and staff invitations. Without it those
# features are unavailable; everything else works.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=AI Tutor <noreply@education.gov.xx>

# Speech. Both default to local models that ship inside the image and need no
# key. Set these only to use ElevenLabs instead.
# TTS_BACKEND=elevenlabs
# STT_BACKEND=elevenlabs
# ELEVENLABS_API_KEY=


# ─────────────────────────────────────────────────────────────────────────
# Not used in this deployment — listed so you know they are deliberate gaps
# ─────────────────────────────────────────────────────────────────────────
#
# AWS_MEDIA_BUCKET   — set only when serving media from S3. Left empty, uploads
#                      go to the `media` volume on this server, which is what
#                      the bundled backup script archives.
# SYNC_SERVER_URL    — only for the offline desktop build syncing to a server.
# AWS_SES_SENDER     — alternative email transport, AWS accounts only.
