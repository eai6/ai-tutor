msgid "Main"
msgstr "Principal"

#: ai_tutor/templates/_includes/_marketing_header.html:46
msgid "Home"
msgstr "Início"

#: ai_tutor/templates/_includes/_marketing_header.html:52
msgid "Teacher/Admin sign in"
msgstr "Entrada de professor/administrador"

#: ai_tutor/templates/_includes/_marketing_header.html:53
msgid "Student sign in"
