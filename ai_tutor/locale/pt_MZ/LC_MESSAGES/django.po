msgstr "uma letra"

#: ai_tutor/apps/accounts/password_validators.py:54
#: ai_tutor/apps/accounts/password_validators.py:77
msgid "a number"
msgstr "um número"

#: ai_tutor/apps/accounts/password_validators.py:56
msgid "a symbol, such as ! ? # or @"
msgstr "um símbolo, como ! ? # ou @"

#: ai_tutor/apps/accounts/password_validators.py:67
#, python-format
msgid "Your password is missing %(missing)s."
msgstr "Falta à sua palavra-passe %(missing)s."

#: ai_tutor/apps/accounts/password_validators.py:79
msgid "a symbol"
msgstr "um símbolo"

#: ai_tutor/apps/accounts/password_validators.py:80
#, python-format
msgid "Your password must contain %(wanted)s."
msgstr "A sua palavra-passe deve conter %(wanted)s."

#: ai_tutor/apps/accounts/scope.py:93
#: ai_tutor/templates/dashboard/staff_list.html:33
#: ai_tutor/templates/dashboard/staff_list.html:145
msgid "Super Admin"
msgstr "Super Administrador"

#: ai_tutor/apps/accounts/scope.py:134
#: ai_tutor/templates/accounts/country_self_register.html:86
#: ai_tutor/templates/dashboard/staff_list.html:145
#: ai_tutor/templates/dashboard/staff_list.html:293
msgid "Country"
msgstr "País"

#: ai_tutor/apps/accounts/scope.py:163
msgid "School Admin"
msgstr "Administrador da Escola"

#: ai_tutor/apps/accounts/scope.py:215
msgid "Teacher"
msgstr "Professor"

#: ai_tutor/apps/accounts/views.py:90 ai_tutor/apps/accounts/views.py:272
#: ai_tutor/apps/accounts/views.py:454
#, python-format
msgid "Welcome back, %(name)s!"
msgstr "Bem-vindo de volta, %(name)s!"

#: ai_tutor/apps/accounts/views.py:238
#, python-format
msgid "Welcome, %(name)s! 🎉 Let's start learning!"
msgstr "Olá, %(name)s! 🎉 Vamos começar a aprender!"

#: ai_tutor/apps/accounts/views.py:465
msgid ""
"That account is not a country account. Use the teacher and admin sign-in."
msgstr ""
"Essa conta não é uma conta de país. Use a entrada de professor e "
"administrador."

#: ai_tutor/apps/accounts/views.py:473
msgid "Your country account is awaiting approval."
msgstr "A sua conta de país aguarda aprovação."

#: ai_tutor/apps/accounts/views.py:478
msgid "Invalid username or password."
msgstr "Nome de utilizador ou palavra-passe inválidos."

#: ai_tutor/apps/accounts/views.py:550
msgid "Please enter your first name."
msgstr "Introduza o seu nome próprio."

#: ai_tutor/apps/accounts/views.py:552
msgid "Username must be at least 3 characters."
msgstr "O nome de utilizador deve ter pelo menos 3 caracteres."

#: ai_tutor/apps/accounts/views.py:554
msgid "Username already taken."
msgstr "Nome de utilizador já existe."

#: ai_tutor/apps/accounts/views.py:556
msgid "Email is required for a country account."
msgstr "O e-mail é obrigatório para uma conta de país."

#: ai_tutor/apps/accounts/views.py:559
msgid "Please choose the country you represent."
msgstr "Escolha o país que representa."

#: ai_tutor/apps/accounts/views.py:562
#, python-format
msgid ""
"%(country)s already has an account on the platform. Ask whoever holds it to "
"add you from their staff page — a country is registered once."
msgstr ""
"%(country)s já tem uma conta na plataforma. Peça a quem a detém que o "
"adicione a partir da página de pessoal — um país regista-se apenas uma "
"vez."

#: ai_tutor/apps/accounts/views.py:567
msgid "Please name the ministry or programme you work for."
msgstr "Indique o ministério ou programa para o qual trabalha."

#: ai_tutor/apps/accounts/views.py:573
msgid "Passwords don't match."
msgstr "As palavras-passe não coincidem."

#: ai_tutor/apps/accounts/views.py:575
msgid "Please read and agree to the platform terms."
msgstr "Leia e aceite os termos da plataforma."

#: ai_tutor/apps/accounts/views.py:616
#, python-format
msgid "Welcome, %(name)s! Your %(country)s account is ready."
msgstr "Bem-vindo, %(name)s! A sua conta %(country)s está pronta."

#: ai_tutor/apps/accounts/views.py:932
msgid "Profile updated."
msgstr "Perfil atualizado."

#: ai_tutor/apps/accounts/views.py:940
msgid "Password changed."
msgstr "Palavra-passe alterada."

#: ai_tutor/apps/accounts/views.py:950
msgid "That tutor option is not available."
msgstr "Essa opção de tutor não está disponível."

#: ai_tutor/apps/accounts/views.py:971
msgid "That offline tutor is not installed."
msgstr "Esse tutor offline não está instalado."

#: ai_tutor/apps/accounts/views.py:977
msgid "Tutor preference saved."
msgstr "Preferência de tutor guardada."

#: ai_tutor/apps/dashboard/attention.py:88
msgid "flagged chats to review"
msgstr "conversas sinalizadas por rever"

#: ai_tutor/apps/dashboard/attention.py:89
msgid "Safety judge flagged these conversations. Unreviewed."
msgstr "O avaliador de segurança sinalizou estas conversas. Por rever."

#: ai_tutor/apps/dashboard/attention.py:102
msgid "students scored lower on retry"
msgstr "alunos com pior nota na repetição"

#: ai_tutor/apps/dashboard/attention.py:103
msgid "Their latest exit ticket is below their first. Check what changed."
msgstr ""
"A última ficha de saída está abaixo da primeira. Verifique o que mudou."

#: ai_tutor/apps/dashboard/attention.py:118
msgid "of sessions stopped before the exit ticket"
msgstr "das sessões terminaram antes da ficha de saída"

#: ai_tutor/apps/dashboard/attention.py:119
msgid ""
"These lessons produced no score. Lesson length or difficulty is the usual "
"cause."
msgstr ""
"Estas lições não produziram nota. A duração ou a dificuldade da lição é a "
"causa habitual."

#: ai_tutor/apps/dashboard/attention.py:132
msgid "mean exit ticket score"
msgstr "nota média da ficha de saída"

#: ai_tutor/apps/dashboard/attention.py:133
msgid "Below the 60% floor across the class. Likely a lesson, not a cohort."
msgstr ""
"Abaixo do mínimo de 60% em toda a turma. Provavelmente é a lição, não a "
"turma."

#: ai_tutor/apps/dashboard/attention.py:146
msgid "students had no session this period"
msgstr "alunos não tiveram nenhuma sessão neste período"

#: ai_tutor/apps/dashboard/attention.py:147
#, python-format
msgid "Out of %(total)s on the roster."
msgstr "De %(total)s inscritos."

#: ai_tutor/apps/dashboard/views.py:299
msgid "weekly"
msgstr "semanal"

#: ai_tutor/apps/dashboard/views.py:1133 ai_tutor/apps/dashboard/views.py:2260
#, python-format
msgid "Promote to %(grade)s"
msgstr "Promover para %(grade)s"

#: ai_tutor/apps/dashboard/views.py:1135 ai_tutor/apps/dashboard/views.py:2262
#: ai_tutor/apps/dashboard/views.py:2263
msgid "Graduate"
msgstr "Graduar"

#: ai_tutor/apps/dashboard/views.py:1137 ai_tutor/apps/dashboard/views.py:2270
#, python-format
msgid "Demote to %(grade)s"
msgstr "Despromover para %(grade)s"

#: ai_tutor/apps/dashboard/views.py:1140
msgid "Reactivate at S5"
msgstr "Reativar em S5"

#: ai_tutor/apps/dashboard/views_country.py:34
#: ai_tutor/apps/dashboard/views_country.py:65
msgid "You don't have access to that."
msgstr "Não tem acesso a isso."

#: ai_tutor/apps/dashboard/views_country.py:71
msgid "A school needs a name."
msgstr "Uma escola precisa de um nome."

#: ai_tutor/apps/dashboard/views_country.py:74
msgid "That short name is already taken."
msgstr "Esse nome curto já está em uso."

#: ai_tutor/apps/dashboard/views_country.py:85
#, fuzzy, python-format
#| msgid "by %(name)s"
msgid "%(name)s added."
msgstr "%(name)s adicionada."

#: ai_tutor/apps/desktop/server_config.py:59
msgid "Enter the address of your school server."
msgstr "Introduza o endereço do servidor da sua escola."

#: ai_tutor/apps/desktop/server_config.py:76
#, python-format
msgid "The address should start with https:// — “%(scheme)s” is not supported."
msgstr "O endereço deve começar por https:// — “%(scheme)s” não é suportado."

#: ai_tutor/apps/desktop/server_config.py:84
msgid "That does not look like a server address."
msgstr "Isso não parece um endereço de servidor."

#: ai_tutor/apps/desktop/server_config.py:90
#, python-format
msgid ""
"Refusing to use an unencrypted connection to %(host)s — student work would "
"be sent in the clear. Use https:// instead, or a server on your own network."
msgstr ""
"Ligação não encriptada a %(host)s recusada — o trabalho dos alunos seria "
"enviado sem protecção. Use https:// ou um servidor na sua própria rede."

#: ai_tutor/apps/desktop/server_config.py:128
msgid "Set the server address first."
msgstr "Defina primeiro o endereço do servidor."

#: ai_tutor/apps/desktop/server_config.py:132
msgid "Enter your username and password."
msgstr "Introduza o seu nome de utilizador e a palavra-passe."

#: ai_tutor/apps/desktop/server_config.py:142
#, python-format
msgid "Could not verify the security certificate for %(host)s."
msgstr "Não foi possível verificar o certificado de segurança de %(host)s."

#: ai_tutor/apps/desktop/server_config.py:146
#, python-format
msgid ""
"Could not reach %(host)s. Check the address and that this computer is online."
msgstr ""
"Não foi possível contactar %(host)s. Verifique o endereço e se este "
"computador está ligado à rede."

#: ai_tutor/apps/desktop/server_config.py:153
#, python-format
msgid "%(host)s answered, but it is not an AI Tutor server."
msgstr "%(host)s respondeu, mas não é um servidor do AI Tutor."

#: ai_tutor/apps/desktop/server_config.py:156
msgid "That username or password is not right."
msgstr "Esse nome de utilizador ou palavra-passe não está correcto."

#: ai_tutor/apps/desktop/server_config.py:159
#, python-format
msgid "The server refused the sign-in (error %(code)s)."
msgstr "O servidor recusou o início de sessão (erro %(code)s)."

#: ai_tutor/apps/desktop/server_config.py:165
msgid "The server did not return a sign-in token."
msgstr "O servidor não devolveu um token de início de sessão."

#: ai_tutor/apps/desktop/views.py:213
msgid "Choose a password of at least 4 characters."
msgstr "Escolha uma palavra-passe com pelo menos 4 caracteres."

#: ai_tutor/apps/desktop/views.py:225
msgid ""
"That name has already been set up on this device. Sign in instead, or ask "
"your teacher."
msgstr ""
"Esse nome já foi configurado neste dispositivo. Inicie sessão ou fale com o "
"seu professor."

#: ai_tutor/apps/desktop/views.py:294
#, python-format
msgid "Saved. Sign in below so your work can be sent to %(url)s."
msgstr ""
"Guardado. Inicie sessão abaixo para que o seu trabalho possa ser enviado "
"para %(url)s."

#: ai_tutor/apps/desktop/views.py:305
msgid ""
"Cleared. Lessons and student work stay on this computer and are not sent "
"anywhere."
msgstr ""
"Limpo. As lições e o trabalho dos alunos ficam neste computador e não são "
"enviados para lado nenhum."

#: ai_tutor/apps/desktop/views.py:322
msgid ""
"Signed in. Work finished on this computer will be sent to your school "
"automatically."
msgstr ""
"Sessão iniciada. O trabalho concluído neste computador será enviado "
"automaticamente para a sua escola."

#: ai_tutor/apps/docs/playbook.py:32
msgid "For discussion — not a commercial offer or a quotation"
msgstr "Para discussão — não é uma oferta comercial nem um orçamento"

#: ai_tutor/apps/docs/playbook.py:34
msgid ""
"Seychelles national pilot (live, secondary geography and mathematics); a "
"second-locale adaptation in preparation; platform source and evaluation "
"harnesses as at August 2026."
msgstr ""
"Projecto-piloto nacional das Seicheles (em curso, geografia e matemática do "
"secundário); adaptação a uma segunda localidade em preparação; código da "
"plataforma e ferramentas de avaliação em Agosto de 2026."

#: ai_tutor/apps/docs/playbook.py:102
msgid "The decision"
msgstr "A decisão"

#: ai_tutor/apps/docs/playbook.py:103
msgid "The implementation"
msgstr "A implementação"

#: ai_tutor/apps/docs/playbook.py:104
msgid "Appendices"
msgstr "Anexos"

#: ai_tutor/apps/docs/playbook.py:110 ai_tutor/templates/docs/index.html:71
msgid "Part I"
msgstr "Parte I"

#: ai_tutor/apps/docs/playbook.py:111 ai_tutor/templates/docs/index.html:84
msgid "Part II"
msgstr "Parte II"

#: ai_tutor/apps/docs/playbook.py:117
msgid ""
"For ministry officials, programme leads and advisors. No technical knowledge "
"assumed."
msgstr ""
"Para quadros do ministério, responsáveis de programa e assessores. Não "
"pressupõe conhecimentos técnicos."

#: ai_tutor/apps/docs/playbook.py:119
msgid "For the technical team that will stand up and run a national instance."
msgstr ""
"Para a equipa técnica que vai instalar e operar uma instância nacional."

#: ai_tutor/apps/docs/playbook.py:121
msgid "Reference material for both audiences."
msgstr "Material de referência para ambos os públicos."

#: ai_tutor/apps/docs/playbook.py:127
msgid "Executive summary"
msgstr "Resumo executivo"

#: ai_tutor/apps/docs/playbook.py:128
msgid ""
"What adoption involves, what a country adapts, and how long a first cohort "
"takes."
msgstr ""
"O que envolve a adopção, o que um país adapta e quanto tempo demora uma "
"primeira turma."

#: ai_tutor/apps/docs/playbook.py:130
msgid "What is actually being adopted"
msgstr "O que está realmente a ser adoptado"

#: ai_tutor/apps/docs/playbook.py:131
msgid ""
"The product as a student, a teacher and a ministry each meet it — and what "
"it is not."
msgstr ""
"O produto tal como o encontram um aluno, um professor e um ministério — e o "
"que ele não é."

#: ai_tutor/apps/docs/playbook.py:133 ai_tutor/apps/docs/playbook.py:231
msgid "The five layers of adaptation"
msgstr "As cinco camadas de adaptação"

#: ai_tutor/apps/docs/playbook.py:134
msgid ""
"Language, curriculum, local context, national structures and infrastructure "
"— five projects, not one."
msgstr ""
"Língua, currículo, contexto local, estruturas nacionais e infra-estrutura — "
"cinco projectos, não um."

#: ai_tutor/apps/docs/playbook.py:136
msgid "Four models of adoption"
msgstr "Quatro modelos de adopção"

#: ai_tutor/apps/docs/playbook.py:137
msgid ""
"Managed, country cloud, single server and offline: who operates it and where "
"the data lives."
msgstr ""
"Gerido, nuvem do país, servidor único e offline: quem o opera e onde ficam "
"os dados."

#: ai_tutor/apps/docs/playbook.py:139
msgid "Data sovereignty: the honest account"
msgstr "Soberania dos dados: o relato honesto"

#: ai_tutor/apps/docs/playbook.py:140
msgid ""
"What stays in country, what leaves and why no setting changes it, and the "
"three ways to close the gap."
msgstr ""
"O que fica no país, o que sai e porque nenhuma configuração o altera, e as "
"três formas de fechar essa lacuna."

#: ai_tutor/apps/docs/playbook.py:142 ai_tutor/apps/docs/playbook.py:215
msgid "Evidence, evaluation and quality assurance"
msgstr "Evidência, avaliação e garantia de qualidade"

#: ai_tutor/apps/docs/playbook.py:143
msgid ""
"Three layers of answer to \"how do you know it teaches well\", and the gate "
"to apply before a cohort."
msgstr ""
"Três níveis de resposta a «como sabe que ensina bem» e o critério a aplicar "
"antes de uma turma."

#: ai_tutor/apps/docs/playbook.py:145
msgid "Teacher training and support"
msgstr "Formação e apoio aos professores"

#: ai_tutor/apps/docs/playbook.py:146
msgid ""
"The part that cannot be bought or deployed: champions, accompaniment, "
"clinics and three lines of support."
msgstr ""
"A parte que não se compra nem se instala: dinamizadores, acompanhamento, "
"sessões de apoio e três linhas de suporte."

#: ai_tutor/apps/docs/playbook.py:148
msgid "Risks and how they are managed"
msgstr "Riscos e como são geridos"

#: ai_tutor/apps/docs/playbook.py:149
msgid ""
"Ten risks, why each one happens, and the control already in place for it."
msgstr ""
"Dez riscos, porque ocorre cada um e o controlo já existente para o mitigar."

#: ai_tutor/apps/docs/playbook.py:152
msgid "National structures"
msgstr "Estruturas nacionais"

#: ai_tutor/apps/docs/playbook.py:153
msgid ""
"Grades, schools, terminology and competency thresholds — all configuration, "
"no migration."
msgstr ""
"Anos, escolas, terminologia e limiares de competência — tudo configuração, "
"sem migração."

#: ai_tutor/apps/docs/playbook.py:155
msgid "Hosting the platform"
msgstr "Alojar a plataforma"

#: ai_tutor/apps/docs/playbook.py:156
msgid ""
"Three server paths and two offline shapes, with the commands, the symptoms "
"and the backup rules."
msgstr ""
"Três caminhos de servidor e dois formatos offline, com os comandos, os "
"sintomas e as regras de cópia de segurança."

#: ai_tutor/apps/docs/playbook.py:159 ai_tutor/apps/docs/playbook.py:201
msgid "Questions to answer before Phase 1"
msgstr "Perguntas a responder antes da Fase 1"

#: ai_tutor/apps/docs/playbook.py:160
msgid ""
"Ten questions. A country that can answer them can start; one that cannot "
"will stall on the unanswered one."
msgstr ""
"Dez perguntas. Um país que saiba respondê-las pode começar; o que não souber "
"ficará bloqueado naquela que ficou por responder."

#: ai_tutor/apps/docs/playbook.py:162
msgid "Glossary"
msgstr "Glossário"

#: ai_tutor/apps/docs/playbook.py:196
msgid "Start here"
msgstr "Comece aqui"

#: ai_tutor/apps/docs/playbook.py:197
msgid "What the thing is, before deciding anything about it."
msgstr "O que isto é, antes de decidir seja o que for a seu respeito."

#: ai_tutor/apps/docs/playbook.py:204
msgid "Decide the shape"
msgstr "Decida o formato"

#: ai_tutor/apps/docs/playbook.py:205
msgid "Where it runs, where the data lives, and who owns each decision."
msgstr "Onde funciona, onde ficam os dados e a quem cabe cada decisão."

#: ai_tutor/apps/docs/playbook.py:210
msgid "Prepare the people"
msgstr "Preparar as pessoas"

#: ai_tutor/apps/docs/playbook.py:211
msgid ""
"The part that cannot be bought or deployed, and how you know it teaches well."
msgstr "A parte que não se compra nem se implanta, e como sabe que ensina bem."

#: ai_tutor/apps/docs/playbook.py:218
msgid "Stand it up"
msgstr "Ponha-o de pé"

#: ai_tutor/apps/docs/playbook.py:219
msgid "Provision the deployment and run it."
msgstr "Aprovisione a implantação e ponha-a a funcionar."

#: ai_tutor/apps/docs/playbook.py:222
msgid "Run it yourself — the short version"
msgstr "Instale por si próprio — a versão curta"

#: ai_tutor/apps/docs/playbook.py:226
msgid "Make it yours"
msgstr "Torne-o seu"

#: ai_tutor/apps/docs/playbook.py:227
msgid "Configure the country: grade names, school register, competency bands."
msgstr ""
"Configure o país: nomes dos anos, registo de escolas, bandas de "
"competência."

#: ai_tutor/apps/support/views.py:74
msgid ""
"Hi 👋 — I'm your AI help assistant. I can answer questions about how the "
"platform works "
msgstr ""
"Olá 👋 — sou o teu assistente AI. Posso responder a perguntas sobre como a "
"plataforma funciona "

#: ai_tutor/apps/support/views.py:75
msgid "or help you navigate the dashboard. "
msgstr "ou ajudar-te a navegar no painel. "

#: ai_tutor/apps/support/views.py:75
msgid "and help you find the right lesson. "
msgstr "e ajudar-te a encontrar a lição certa. "

#: ai_tutor/apps/support/views.py:76
msgid "What's up?"
msgstr "Tudo bem?"

#: ai_tutor/apps/tutoring/simple_tutor/engine.py:3310
msgid ""
"Great — you've worked through the lesson! Now let's check what you've locked "
"in with a short quiz. Take your time on each question, then submit."
msgstr ""
"Boa — terminaste a lição! Agora vamos ver o que fixaste com um pequeno "
"questionário. Pensa bem em cada pergunta e depois submete."

#: ai_tutor/apps/tutoring/simple_tutor/engine.py:3631
msgid "This lesson is complete. Open Review to go back over it."
msgstr "Esta lição está concluída. Abra a Revisão para a rever."

#: ai_tutor/apps/tutoring/simple_tutor/engine.py:3784
msgid ""
"👋 Welcome back! You were working on this question — let's pick up where we "
"left off:"
msgstr ""
"👋 Bem-vindo de volta! Estavas a trabalhar nesta pergunta — vamos continuar "
"de onde paraste:"

#: ai_tutor/apps/tutoring/simple_tutor/exit_ticket.py:293
#, python-format
msgid "🎉 You scored %(score)d/%(total)d — that's a pass. Well done!"
msgstr "🎉 Tiveste %(score)d/%(total)d — passaste. Parabéns!"

#: ai_tutor/apps/tutoring/simple_tutor/exit_ticket.py:297
#, python-format
msgid ""
"📋 **Exit ticket review**\n"
"\n"
"You scored %(score)d out of %(total)d. Let's revisit the concepts you missed."
msgstr ""
"📋 **Revisão da avaliação final**\n"
"\n"
"Tiveste %(score)d em %(total)d. Vamos rever os conceitos que falhaste."

#: ai_tutor/apps/tutoring/views.py:632
#, python-format
msgid "This device still needs: %(items)s. Finish setup to start lessons."
msgstr ""
"Este dispositivo ainda precisa de: %(items)s. Conclua a configuração para "
"começar as lições."

