msgstr "Pays"

#: ai_tutor/apps/accounts/scope.py:152
msgid "School Admin"
msgstr "Administrateur d'établissement"

#: ai_tutor/apps/accounts/scope.py:203
msgid "Teacher"
msgstr "Enseignant"

#: ai_tutor/apps/accounts/views.py:90 ai_tutor/apps/accounts/views.py:272
#: ai_tutor/apps/accounts/views.py:454
#, python-format
msgid "Welcome back, %(name)s!"
msgstr "Bon retour, %(name)s !"

#: ai_tutor/apps/accounts/views.py:238
#, python-format
msgid "Welcome, %(name)s! 🎉 Let's start learning!"
msgstr "Bienvenue, %(name)s ! 🎉 Commençons à apprendre !"

#: ai_tutor/apps/accounts/views.py:465
msgid ""
"That account is not a country account. Use the teacher and admin sign-in."
msgstr ""

#: ai_tutor/apps/accounts/views.py:473
msgid "Your country account is awaiting approval."
msgstr "Votre compte pays est en attente d'approbation."

#: ai_tutor/apps/accounts/views.py:478
msgid "Invalid username or password."
msgstr "Nom d'utilisateur ou mot de passe invalide."

#: ai_tutor/apps/accounts/views.py:528
msgid "Please enter your first name."
msgstr "Veuillez saisir votre prénom."

#: ai_tutor/apps/accounts/views.py:530
msgid "Username must be at least 3 characters."
msgstr "Le nom d'utilisateur doit comporter au moins 3 caractères."

#: ai_tutor/apps/accounts/views.py:532
msgid "Username already taken."
msgstr "Ce nom d'utilisateur est déjà pris."

#: ai_tutor/apps/accounts/views.py:534
msgid "Email is required for a country account."
msgstr "Une adresse e-mail est requise pour un compte pays."

#: ai_tutor/apps/accounts/views.py:537
msgid "Please choose the country you represent."
msgstr "Veuillez choisir le pays que vous représentez."

#: ai_tutor/apps/accounts/views.py:539
msgid "Please name the ministry or programme you work for."
msgstr ""
"Veuillez nommer le ministère ou le programme pour lequel vous travaillez."

#: ai_tutor/apps/accounts/views.py:545
msgid "Passwords don't match."
msgstr "Les mots de passe ne correspondent pas."

#: ai_tutor/apps/accounts/views.py:547
msgid "Please read and agree to the platform terms."
msgstr "Veuillez lire et accepter les conditions de la plateforme."

#: ai_tutor/apps/accounts/views.py:900
msgid "Profile updated."
msgstr "Profil mis à jour."

#: ai_tutor/apps/accounts/views.py:908
msgid "Password changed."
msgstr "Mot de passe modifié."

#: ai_tutor/apps/accounts/views.py:918
msgid "That tutor option is not available."
msgstr "Cette option de tuteur n'est pas disponible."

#: ai_tutor/apps/accounts/views.py:939
msgid "That offline tutor is not installed."
msgstr "Ce tuteur hors ligne n'est pas installé."

#: ai_tutor/apps/accounts/views.py:945
msgid "Tutor preference saved."
msgstr "Préférence de tuteur enregistrée."

#: ai_tutor/apps/dashboard/attention.py:88
msgid "flagged chats to review"
msgstr "conversations signalées à examiner"

#: ai_tutor/apps/dashboard/attention.py:89
msgid "Safety judge flagged these conversations. Unreviewed."
msgstr "L'évaluateur de sécurité a signalé ces conversations. Non examinées."

#: ai_tutor/apps/dashboard/attention.py:102
msgid "students scored lower on retry"
msgstr "élèves ont eu une note plus basse à la reprise"

#: ai_tutor/apps/dashboard/attention.py:103
msgid "Their latest exit ticket is below their first. Check what changed."
msgstr ""
"Leur dernier billet de sortie est inférieur au premier. Vérifiez ce qui a "
"changé."

#: ai_tutor/apps/dashboard/attention.py:118
msgid "of sessions stopped before the exit ticket"
msgstr "des séances se sont arrêtées avant le billet de sortie"

#: ai_tutor/apps/dashboard/attention.py:119
msgid ""
"These lessons produced no score. Lesson length or difficulty is the usual "
"cause."
msgstr ""
"Ces leçons n'ont produit aucune note. La longueur ou la difficulté de la "
"leçon en est la cause habituelle."

#: ai_tutor/apps/dashboard/attention.py:132
msgid "mean exit ticket score"
msgstr "note moyenne du billet de sortie"

#: ai_tutor/apps/dashboard/attention.py:133
msgid "Below the 60% floor across the class. Likely a lesson, not a cohort."
msgstr ""
"Sous le seuil de 60 % pour toute la classe. Probablement la leçon, pas le "
"groupe."

#: ai_tutor/apps/dashboard/attention.py:146
msgid "students had no session this period"
msgstr "élèves n'ont eu aucune séance sur cette période"

#: ai_tutor/apps/dashboard/attention.py:147
#, python-format
msgid "Out of %(total)s on the roster."
msgstr "Sur %(total)s inscrits."

#: ai_tutor/apps/dashboard/views.py:299
msgid "weekly"
msgstr "hebdomadaire"

#: ai_tutor/apps/dashboard/views.py:1133 ai_tutor/apps/dashboard/views.py:2260
#, python-format
msgid "Promote to %(grade)s"
msgstr "Faire passer en %(grade)s"

#: ai_tutor/apps/dashboard/views.py:1135 ai_tutor/apps/dashboard/views.py:2262
#: ai_tutor/apps/dashboard/views.py:2263
msgid "Graduate"
msgstr "Diplômer"

#: ai_tutor/apps/dashboard/views.py:1137 ai_tutor/apps/dashboard/views.py:2270
#, python-format
msgid "Demote to %(grade)s"
msgstr "Redescendre en %(grade)s"

#: ai_tutor/apps/dashboard/views.py:1140
msgid "Reactivate at S5"
msgstr "Réactiver en S5"

#: ai_tutor/apps/dashboard/views_country.py:34
#: ai_tutor/apps/dashboard/views_country.py:65
msgid "You don't have access to that."
msgstr "Vous n'avez pas accès à cela."

#: ai_tutor/apps/dashboard/views_country.py:71
msgid "A school needs a name."
msgstr "Une école a besoin d'un nom."

#: ai_tutor/apps/dashboard/views_country.py:74
msgid "That short name is already taken."
msgstr "Ce nom court est déjà pris."

#: ai_tutor/apps/dashboard/views_country.py:85
#, fuzzy, python-format
#| msgid "by %(name)s"
msgid "%(name)s added."
msgstr "%(name)s ajoutée."

#: ai_tutor/apps/desktop/server_config.py:59
msgid "Enter the address of your school server."
msgstr "Saisissez l'adresse du serveur de votre école."

#: ai_tutor/apps/desktop/server_config.py:76
#, python-format
msgid "The address should start with https:// — “%(scheme)s” is not supported."
msgstr ""
"L'adresse doit commencer par https:// — « %(scheme)s » n'est pas pris en "
"charge."

#: ai_tutor/apps/desktop/server_config.py:84
msgid "That does not look like a server address."
msgstr "Cela ne ressemble pas à une adresse de serveur."

#: ai_tutor/apps/desktop/server_config.py:90
#, python-format
msgid ""
"Refusing to use an unencrypted connection to %(host)s — student work would "
"be sent in the clear. Use https:// instead, or a server on your own network."
msgstr ""
"Connexion non chiffrée à %(host)s refusée — le travail des élèves serait "
"envoyé en clair. Utilisez plutôt https://, ou un serveur sur votre propre "
"réseau."

#: ai_tutor/apps/desktop/server_config.py:128
msgid "Set the server address first."
msgstr "Définissez d'abord l'adresse du serveur."

#: ai_tutor/apps/desktop/server_config.py:132
msgid "Enter your username and password."
msgstr "Saisissez votre nom d'utilisateur et votre mot de passe."

#: ai_tutor/apps/desktop/server_config.py:142
#, python-format
msgid "Could not verify the security certificate for %(host)s."
msgstr "Impossible de vérifier le certificat de sécurité de %(host)s."

#: ai_tutor/apps/desktop/server_config.py:146
#, python-format
msgid ""
"Could not reach %(host)s. Check the address and that this computer is online."
msgstr ""
"Impossible de joindre %(host)s. Vérifiez l'adresse et que cet ordinateur est "
"connecté."

#: ai_tutor/apps/desktop/server_config.py:153
#, python-format
msgid "%(host)s answered, but it is not an AI Tutor server."
msgstr "%(host)s a répondu, mais ce n'est pas un serveur AI Tutor."

#: ai_tutor/apps/desktop/server_config.py:156
msgid "That username or password is not right."
msgstr "Ce nom d'utilisateur ou ce mot de passe est incorrect."

#: ai_tutor/apps/desktop/server_config.py:159
#, python-format
msgid "The server refused the sign-in (error %(code)s)."
msgstr "Le serveur a refusé la connexion (erreur %(code)s)."

#: ai_tutor/apps/desktop/server_config.py:165
msgid "The server did not return a sign-in token."
msgstr "Le serveur n'a pas renvoyé de jeton de connexion."

#: ai_tutor/apps/desktop/views.py:213
msgid "Choose a password of at least 4 characters."
msgstr "Choisissez un mot de passe d'au moins 4 caractères."

#: ai_tutor/apps/desktop/views.py:225
msgid ""
"That name has already been set up on this device. Sign in instead, or ask "
"your teacher."
msgstr ""
"Ce nom a déjà été configuré sur cet appareil. Connectez-vous plutôt, ou "
"demandez à votre enseignant."

#: ai_tutor/apps/desktop/views.py:294
#, python-format
msgid "Saved. Sign in below so your work can be sent to %(url)s."
msgstr ""
"Enregistré. Connectez-vous ci-dessous pour que votre travail puisse être "
"envoyé à %(url)s."

#: ai_tutor/apps/desktop/views.py:305
msgid ""
"Cleared. Lessons and student work stay on this computer and are not sent "
"anywhere."
msgstr ""
"Effacé. Les leçons et le travail des élèves restent sur cet ordinateur et ne "
"sont envoyés nulle part."

#: ai_tutor/apps/desktop/views.py:322
msgid ""
"Signed in. Work finished on this computer will be sent to your school "
"automatically."
msgstr ""
"Connecté. Le travail terminé sur cet ordinateur sera envoyé automatiquement "
"à votre école."

#: ai_tutor/apps/docs/playbook.py:32
msgid "For discussion — not a commercial offer or a quotation"
msgstr "Document de travail — ni offre commerciale ni devis"

#: ai_tutor/apps/docs/playbook.py:34
msgid ""
"Seychelles national pilot (live, secondary geography and mathematics); a "
"second-locale adaptation in preparation; platform source and evaluation "
"harnesses as at August 2026."
msgstr ""
"Projet pilote national des Seychelles (en cours, géographie et mathématiques "
"du secondaire) ; adaptation à une seconde localité en préparation ; code de "
"la plateforme et outils d'évaluation au mois d'août 2026."

#: ai_tutor/apps/docs/playbook.py:39
msgid ""
"Observed pilot figures, given as planning inputs. They are not prices and "
"must be re-derived for each country."
msgstr ""
"Chiffres observés lors du pilote, fournis comme données de planification. Ce "
"ne sont pas des prix et ils doivent être recalculés pour chaque pays."

#: ai_tutor/apps/docs/playbook.py:106
msgid "The decision"
msgstr "La décision"

#: ai_tutor/apps/docs/playbook.py:107
msgid "The implementation"
msgstr "La mise en œuvre"

#: ai_tutor/apps/docs/playbook.py:108
msgid "Appendices"
msgstr "Annexes"

#: ai_tutor/apps/docs/playbook.py:114 ai_tutor/templates/docs/index.html:71
msgid "Part I"
msgstr "Partie I"

#: ai_tutor/apps/docs/playbook.py:115 ai_tutor/templates/docs/index.html:84
msgid "Part II"
msgstr "Partie II"

#: ai_tutor/apps/docs/playbook.py:121
msgid ""
"For ministry officials, programme leads and advisors. No technical knowledge "
"assumed."
msgstr ""
"Pour les cadres du ministère, les responsables de programme et les "
"conseillers. Aucune connaissance technique requise."

#: ai_tutor/apps/docs/playbook.py:123
msgid "For the technical team that will stand up and run a national instance."
msgstr ""
"Pour l'équipe technique qui installera et exploitera une instance nationale."

#: ai_tutor/apps/docs/playbook.py:125
msgid "Reference material for both audiences."
msgstr "Documentation de référence pour les deux publics."

#: ai_tutor/apps/docs/playbook.py:131
msgid "Executive summary"
msgstr "Résumé exécutif"

#: ai_tutor/apps/docs/playbook.py:132
msgid ""
"What adoption involves, what a country adapts, and how long a first cohort "
"takes."
msgstr ""
"Ce qu'implique l'adoption, ce qu'un pays adapte et le temps que demande une "
"première cohorte."

#: ai_tutor/apps/docs/playbook.py:134
msgid "What is actually being adopted"
msgstr "Ce qui est réellement adopté"

#: ai_tutor/apps/docs/playbook.py:135
msgid ""
"The product as a student, a teacher and a ministry each meet it — and what "
"it is not."
msgstr ""
"Le produit tel que le rencontrent un élève, un enseignant et un ministère — "
"et ce qu'il n'est pas."

#: ai_tutor/apps/docs/playbook.py:137 ai_tutor/apps/docs/playbook.py:270
msgid "The five layers of adaptation"
msgstr "Les cinq couches d'adaptation"

#: ai_tutor/apps/docs/playbook.py:138
msgid ""
"Language, curriculum, local context, national structures and infrastructure "
"— five projects, not one."
msgstr ""
"Langue, programme, contexte local, structures nationales et infrastructure — "
"cinq chantiers, pas un seul."

#: ai_tutor/apps/docs/playbook.py:140
msgid "Four models of adoption"
msgstr "Quatre modèles d'adoption"

#: ai_tutor/apps/docs/playbook.py:141
msgid ""
"Managed, country cloud, single server and offline: who operates it and where "
"the data lives."
msgstr ""
"Infogéré, nuage national, serveur unique et hors ligne : qui l'exploite et "
"où résident les données."

#: ai_tutor/apps/docs/playbook.py:143
msgid "Data sovereignty: the honest account"
msgstr "Souveraineté des données : l'exposé honnête"

#: ai_tutor/apps/docs/playbook.py:144
msgid ""
"What stays in country, what leaves and why no setting changes it, and the "
"three ways to close the gap."
msgstr ""
"Ce qui reste dans le pays, ce qui en sort et pourquoi aucun réglage n'y "
"change rien, et les trois façons de combler l'écart."

#: ai_tutor/apps/docs/playbook.py:146
msgid "What it costs, and what drives the cost"
msgstr "Ce que cela coûte, et ce qui détermine le coût"

#: ai_tutor/apps/docs/playbook.py:147
msgid ""
"The fixed infrastructure line, the model spend that dominates it, and the "
"levers worth pulling."
msgstr ""
"Le poste fixe d'infrastructure, la dépense en modèles qui le domine et les "
"leviers qui valent la peine d'être actionnés."

#: ai_tutor/apps/docs/playbook.py:149
msgid "Cost sharing and sustainability"
msgstr "Partage des coûts et pérennité"

#: ai_tutor/apps/docs/playbook.py:150
msgid ""
"Who pays for which line, four funding models, and whether it is still funded "
"in year three."
msgstr ""
"Qui paie quel poste, quatre modèles de financement, et si le dispositif est "
"encore financé en troisième année."

#: ai_tutor/apps/docs/playbook.py:152 ai_tutor/apps/docs/playbook.py:254
msgid "Evidence, evaluation and quality assurance"
msgstr "Données probantes, évaluation et assurance qualité"

#: ai_tutor/apps/docs/playbook.py:153
msgid ""
"Three layers of answer to \"how do you know it teaches well\", and the gate "
"to apply before a cohort."
msgstr ""
"Trois niveaux de réponse à « comment savez-vous qu'il enseigne bien », et le "
"critère à appliquer avant une cohorte."

#: ai_tutor/apps/docs/playbook.py:155
msgid "A phased adoption roadmap"
msgstr "Une feuille de route d'adoption par phases"

#: ai_tutor/apps/docs/playbook.py:156
msgid ""
"Six phases from decision to scale, each with an owner and an exit criterion."
msgstr ""
"Six phases de la décision au passage à l'échelle, chacune avec un "
"responsable et un critère de sortie."

#: ai_tutor/apps/docs/playbook.py:158
msgid "Teacher training and support"
msgstr "Formation et accompagnement des enseignants"

#: ai_tutor/apps/docs/playbook.py:159
msgid ""
"The part that cannot be bought or deployed: champions, accompaniment, "
"clinics and three lines of support."
msgstr ""
"La part qui ne s'achète ni ne se déploie : référents, accompagnement, "
"ateliers et trois niveaux de soutien."

#: ai_tutor/apps/docs/playbook.py:161
msgid "Governance and what the country must provide"
msgstr "Gouvernance et ce que le pays doit fournir"

#: ai_tutor/apps/docs/playbook.py:162
msgid ""
"The five roles that need a name against them, and what each side supplies."
msgstr ""
"Les cinq rôles auxquels il faut associer un nom, et ce que chaque partie "
"fournit."

#: ai_tutor/apps/docs/playbook.py:164 ai_tutor/apps/docs/playbook.py:278
msgid "Risks and how they are managed"
msgstr "Risques et gestion des risques"

#: ai_tutor/apps/docs/playbook.py:165
msgid ""
"Ten risks, why each one happens, and the control already in place for it."
msgstr ""
"Dix risques, la raison de chacun et le dispositif déjà en place pour le "
"maîtriser."

#: ai_tutor/apps/docs/playbook.py:168
msgid "Country onboarding checklist"
msgstr "Liste de contrôle pour l'intégration d'un pays"

#: ai_tutor/apps/docs/playbook.py:169
msgid ""
"Nine steps in order, and where each one lives. Content is step five for a "
"reason."
msgstr ""
"Neuf étapes dans l'ordre, et où chacune se déroule. Le contenu est la "
"cinquième étape, et ce n'est pas un hasard."

#: ai_tutor/apps/docs/playbook.py:171
msgid "Language and locale adaptation"
msgstr "Adaptation linguistique et locale"

#: ai_tutor/apps/docs/playbook.py:172
msgid ""
"The five places a locale is registered, which language wins per request, and "
"the register decisions to settle first."
msgstr ""
"Les cinq endroits où une localité est enregistrée, quelle langue l'emporte à "
"chaque requête, et les décisions de registre à trancher en premier."

#: ai_tutor/apps/docs/playbook.py:174
msgid "Curriculum ingestion and the content pipeline"
msgstr "Intégration du programme et chaîne de production du contenu"

#: ai_tutor/apps/docs/playbook.py:175
msgid ""
"Two routes in, the eight generation steps, and why review throughput is the "
"schedule."
msgstr ""
"Deux voies d'entrée, les huit étapes de génération, et pourquoi c'est la "
"capacité de relecture qui fixe le calendrier."

#: ai_tutor/apps/docs/playbook.py:177
msgid "National structures"
msgstr "Structures nationales"

#: ai_tutor/apps/docs/playbook.py:178
msgid ""
"Grades, schools, terminology and competency thresholds — all configuration, "
"no migration."
msgstr ""
"Niveaux, écoles, terminologie et seuils de compétence — tout est "
"configuration, aucune migration."

#: ai_tutor/apps/docs/playbook.py:180
msgid "Hosting the platform"
msgstr "Héberger la plateforme"

#: ai_tutor/apps/docs/playbook.py:181
msgid ""
"Three server paths and two offline shapes, with the commands, the symptoms "
"and the backup rules."
msgstr ""
"Trois parcours serveur et deux configurations hors ligne, avec les "
"commandes, les symptômes et les règles de sauvegarde."

#: ai_tutor/apps/docs/playbook.py:183
msgid "Quality gates before a cohort"
msgstr "Critères de qualité avant une cohorte"

#: ai_tutor/apps/docs/playbook.py:184
msgid ""
"Three harnesses at three units of analysis, and why judges are a filter "
"rather than a gate."
msgstr ""
"Trois dispositifs à trois échelles d'analyse, et pourquoi les évaluateurs "
"sont un filtre plutôt qu'une barrière."

#: ai_tutor/apps/docs/playbook.py:186
msgid "Operating the platform"
msgstr "Exploiter la plateforme"

#: ai_tutor/apps/docs/playbook.py:187
msgid ""
"Backups, upgrades, secrets, monitoring, flagged sessions and the login "
"lockout rule."
msgstr ""
"Sauvegardes, mises à niveau, secrets, supervision, séances signalées et "
"règle de verrouillage des connexions."

#: ai_tutor/apps/docs/playbook.py:189
msgid "Integration surface"
msgstr "Surface d'intégration"

#: ai_tutor/apps/docs/playbook.py:190
msgid ""
"A versioned REST API, a published schema, and a realistic integration scope "
"for a pilot."
msgstr ""
"Une API REST versionnée, un schéma publié et un périmètre d'intégration "
"réaliste pour un pilote."

#: ai_tutor/apps/docs/playbook.py:193
msgid "Case study: what a second adaptation changed"
msgstr "Étude de cas : ce qu'a changé une seconde adaptation"

#: ai_tutor/apps/docs/playbook.py:194
msgid ""
"The real change list from taking the platform to a second country. No schema "
"redesign appears in it."
msgstr ""
"La liste réelle des changements induits par le portage de la plateforme vers "
"un deuxième pays. Aucune refonte du schéma n'y figure."

#: ai_tutor/apps/docs/playbook.py:196 ai_tutor/apps/docs/playbook.py:238
msgid "Questions to answer before Phase 1"
msgstr "Questions à trancher avant la phase 1"

#: ai_tutor/apps/docs/playbook.py:197
msgid ""
"Ten questions. A country that can answer them can start; one that cannot "
"will stall on the unanswered one."
msgstr ""
"Dix questions. Un pays capable d'y répondre peut démarrer ; celui qui ne le "
"peut pas butera sur celle restée sans réponse."

#: ai_tutor/apps/docs/playbook.py:199
msgid "Glossary"
msgstr "Glossaire"

#: ai_tutor/apps/docs/playbook.py:233
msgid "Start here"
msgstr "Commencez ici"

#: ai_tutor/apps/docs/playbook.py:234
msgid "What the thing is, before deciding anything about it."
msgstr "Ce dont il s'agit, avant d'en décider quoi que ce soit."

#: ai_tutor/apps/docs/playbook.py:241
msgid "Decide the shape"
msgstr "Choisissez la configuration"

#: ai_tutor/apps/docs/playbook.py:242
msgid "Where it runs, where the data lives, and who owns each decision."
msgstr ""
"Où cela tourne, où résident les données et à qui revient chaque décision."

#: ai_tutor/apps/docs/playbook.py:246
msgid "What a second adaptation changed"
msgstr "Ce qu'a changé une seconde adaptation"

#: ai_tutor/apps/docs/playbook.py:249
msgid "Plan and fund it"
msgstr "Planifiez et financez"

#: ai_tutor/apps/docs/playbook.py:250
msgid ""
"What it costs, who carries which line, and how a first cohort is sequenced."
msgstr ""
