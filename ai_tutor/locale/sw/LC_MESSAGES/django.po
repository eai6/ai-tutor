#: ai_tutor/templates/accounts/settings.html:235
msgid ""
"Automatic uses the internet tutor when you are connected and switches to the "
"offline one when you are not, so a lost connection will not stop your lesson."
msgstr ""
"Otomatiki hutumia mkufunzi wa intaneti unapokuwa umeunganishwa na hubadilika "
"kwenda wa bila mtandao usipokuwa, hivyo muunganisho uliopotea hautasimamisha "
"somo lako."

#: ai_tutor/templates/accounts/settings.html:249
msgid "Offline tutor"
msgstr "Mkufunzi bila mtandao"

#: ai_tutor/templates/accounts/settings.html:251
