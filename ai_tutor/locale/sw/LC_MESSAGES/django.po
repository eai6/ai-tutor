#: ai_tutor/templates/accounts/settings.html:222
msgid "Choose which tutor to learn with. This is remembered for every lesson."
msgstr "Chagua mkufunzi wa kujifunza naye. Hii hukumbukwa kwa kila somo."

#: ai_tutor/templates/accounts/settings.html:228
